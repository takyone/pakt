{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pakt.dev/schemas/conformance-case.schema.json",
  "title": "pakt conformance case (conformance/<skill>/case-*.yaml)",
  "type": "object",
  "required": ["prompt", "expect"],
  "additionalProperties": false,
  "properties": {
    "prompt": { "type": "string", "minLength": 1 },
    "fixture": { "type": "object" },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must_call": { "type": "array", "items": { "type": "string" } },
        "must_delegate": { "type": "string" },
        "must_not": { "type": "array", "items": { "type": "string" } },
        "output_shape": { "type": "string" }
      }
    },
    "judge_model": { "type": "string" }
  }
}
